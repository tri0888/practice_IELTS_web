# Copy to .env.local for local dev; on Vercel set the same names in the frontend project.

# Base URL of the backend service (../backend). /api/* is proxied there.
# Default: http://127.0.0.1:8000 (the backend's `npm run dev`). Read at build time.
NEXT_PUBLIC_API_URL=

# Same value as the backend's JWT_SECRET — lets proxy.ts verify token signatures.
JWT_SECRET=

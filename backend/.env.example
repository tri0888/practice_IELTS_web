# Copy to .env.local (or .env) for local dev; on Vercel set the same names in the BACKEND project.

# --- MongoDB (required: auth, histories, vocabulary progress, Telegram sessions) ---
MONGODB_URI=
# Optional: replaces the password inside MONGODB_URI
DB_PASSWORD=
# Default: ielts_platform_dev
DB_NAME=

# --- Auth ---
# REQUIRED in production. Set the same value in the frontend (used by proxy.ts).
JWT_SECRET=

# --- Cloudflare R2 (PDF + audio storage) ---
USE_R2=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Source PDFs kept in memory per instance (each ~50 MB). Default 2.
# R2_MEMORY_CACHE_FILES=2

# --- Telegram bot (optional) ---
TELEGRAM_BOT_TOKEN=
# Public base URL of THIS backend, e.g. https://your-api.vercel.app
TELEGRAM_WEBHOOK_URL=
# Recommended. After setting it run `npm run telegram:webhook`.
TELEGRAM_WEBHOOK_SECRET=
# Default en-GB-SoniaNeural
FLASHCARD_TTS_VOICE=
# Only for `npm run seed:tts` (your numeric Telegram id)
SEED_CHAT_ID=

# --- Local dev server ---
# PORT=8000

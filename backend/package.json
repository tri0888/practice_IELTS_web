{
  "name": "ielts-backend",
  "version": "1.0.0",
  "private": true,
  "description": "IELTS/TOEIC practice API (Hono on Node.js) — replaces the former FastAPI backend",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "start": "tsx src/dev.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "seed:tts": "tsx scripts/seed-tts.ts",
    "telegram:webhook": "tsx scripts/set-telegram-webhook.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@hono/node-server": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "grammy": "^1.46.0",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "mongodb": "^7.9.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/node": "25.9.2",
    "msedge-tts": "^2.1.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^2.1.0"
  }
}

{
  "name": "ielts-backend",
  "version": "1.0.0",
  "private": true,
  "description": "IELTS/TOEIC practice API (TypeScript on Node.js, plain node:http)",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.ts",
    "start": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed.ts",
    "seed:tts": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-tts.ts",
    "telegram:webhook": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/set-telegram-webhook.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "bcryptjs": "^3.0.3",
    "grammy": "^1.46.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.9.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "25.9.2",
    "msedge-tts": "^2.1.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^2.1.0"
  }
}
